# ─── RAG Docs AI Stack — Environment Variables ─────────────────────────────
# Copy this file to .env and fill in the values before running docker compose.
#   cp .env.example .env

# ── OpenWebUI ────────────────────────────────────────────────────────────────
# REQUIRED: change this to a long random string in production
OPENWEBUI_SECRET_KEY=change-me-use-a-long-random-string

# Port OpenWebUI listens on (host side)
OPENWEBUI_PORT=3001

# Display name in the OpenWebUI header
WEBUI_NAME=RAG Docs

# ── OVMS ─────────────────────────────────────────────────────────────────────
# Host-side ports for OVMS
OVMS_REST_PORT=8001
OVMS_GRPC_PORT=9001

# Used by OpenWebUI to call OVMS as an OpenAI-compatible LLM backend.
# Change the model name to match what you have loaded in ovms/config.json.
# If no LLM is loaded in OVMS, set ENABLE_OPENAI_API=false.
OVMS_OPENAI_URL=http://ovms:8001/v1
OVMS_API_KEY=sk-ovms-unused
ENABLE_OPENAI_API=true

# ── ChromaDB ─────────────────────────────────────────────────────────────────
CHROMA_PORT=8000
CHROMA_TENANT=default_tenant
CHROMA_DATABASE=default_database

# Uncomment to enable ChromaDB basic auth:
# CHROMA_BASIC_AUTH=admin:changeme

# ── Go Backend (runs on host, not in Docker) ──────────────────────────────────
# These are consumed by the Go backend (backend/config/config.go).
# OVMS_BASE_URL will be set once OVMS is available.
# OVMS_BASE_URL=http://localhost:8001
# OVMS_MODEL_NAME=bge-small-en
# OVMS_EMBEDDING_DIM=384
VECTOR_STORE_URL=http://localhost:8000
VECTOR_STORE_BACKEND=chroma
CHUNK_SIZE=380
CHUNK_OVERLAP=40
EMBEDDING_ENABLED=false
